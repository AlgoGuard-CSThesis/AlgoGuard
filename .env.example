# AlgoGuard — analyst environment file
#
# Copy this to `.env` in the repo root. Everything here is safe for an
# ordinary analyst installation: no database password, no service/secret
# key, and no JWT signing secret belongs in this file. Those are
# maintainer-only credentials — see .env.maintainer.example instead, which
# is never packaged or committed.

# --- Local application (SQLite mode, current default) ---
ALGOGUARD_HOST=127.0.0.1
ALGOGUARD_PORT=5000
FLASK_DEBUG=0
ALGOGUARD_SECURE_COOKIES=0

# Leave unset to use the local sqlite3 file under ./database/
# ALGOGUARD_DATABASE_PATH=

# Leave unset to use ./saved_models/deployed_model.joblib
# ALGOGUARD_DEPLOYED_MODEL_PATH=

# Optional runtime directories (defaults shown). A model-directory override
# also changes the default deployed-model path unless explicitly overridden.
# ALGOGUARD_SAVED_MODEL_FOLDER=./saved_models
# ALGOGUARD_REPORT_FOLDER=./reports
# ALGOGUARD_CAPTURE_FOLDER=./captures

# First-run admin bootstrap (see train.py / database_service.seed_default_admin)
# ALGOGUARD_ADMIN_USERNAME=admin
# ALGOGUARD_ADMIN_EMAIL=admin@algoguard.local
# Leave ALGOGUARD_ADMIN_PASSWORD unset to have one generated and printed once.

# --- Cloud mode (Stage 5D+; safe to set ahead of time) ---
# Public project URL and publishable (anon) key only. These are safe to
# ship in an analyst build; they carry no elevated privileges on their own
# — access is enforced server-side via RLS policies (Stage 5B).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Explicit mode switch. "sqlite" (default) or "supabase".
# "supabase" is rejected until Stage 5D implements cloud persistence, even
# when both public settings are present. It never falls back to SQLite.
ALGOGUARD_DB_MODE=sqlite
