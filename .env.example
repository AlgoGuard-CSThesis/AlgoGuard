# AlgoGuard — analyst settings
#
# Copy this file to `.env` in the AlgoGuard folder (SETUP_ALGOGUARD.cmd does
# it for you) and fill in the two cloud values your administrator gives you.
# Everything here is safe for an analyst installation: no database password,
# no secret or service key, and no signing secret ever belongs in this file.
# Those are maintainer-only and live in `.env.maintainer`, which is never
# packaged or committed.

# --- Cloud project (required) ---
# The project's https:// URL and its publishable key (starts with
# sb_publishable_). Both are public values: access is enforced by the cloud
# for each signed-in account. A secret or service key is refused at startup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local web console ---
# AlgoGuard serves its pages on this computer only. Cloud mode refuses any
# host other than 127.0.0.1, localhost or ::1.
ALGOGUARD_HOST=127.0.0.1
ALGOGUARD_PORT=5000
FLASK_DEBUG=0

# --- Local state ---
# This installation's ID (`node-id`), records waiting to upload, and the
# downloaded model. Defaults to the `.algoguard` folder inside AlgoGuard.
# Do not copy, share or rename this folder after the first sign-in: a new
# folder is a new installation that needs approval again.
# ALGOGUARD_STATE_DIR=.algoguard

# --- Maintenance only ---
# Legacy local mode keeps every record in a SQLite database on this computer
# and never uploads. It exists for installations that have not been moved to
# the cloud yet, and for maintainers. Analysts leave it unset.
# ALGOGUARD_DB_MODE=sqlite
# Legacy local mode only: database path and first-run administrator.
# ALGOGUARD_DATABASE_PATH=./database/algoguard.sqlite3
# ALGOGUARD_ADMIN_USERNAME=admin
# ALGOGUARD_ADMIN_EMAIL=admin@algoguard.local
