# Jupyter checkpoints
.ipynb_checkpoints/

# Generated research outputs
research/dataset/processed/*
!research/dataset/processed/.gitkeep
research/models/*
!research/models/.gitkeep

# Backup files
*.bak
*.tmp

# Test and lint output
.pytest_cache/
.ruff_cache/
check-output/
.coverage
htmlcov/

# Runtime artifacts
uploads/*
!uploads/.gitignore
!uploads/.gitkeep
saved_models/*
!saved_models/.gitignore
!saved_models/.gitkeep
reports/*
!reports/.gitignore
!reports/.gitkeep
database/*
!database/.gitignore
!database/.gitkeep

# Packet capture recordings (may contain traffic from your network)
captures/*
!captures/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
ENV/

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.maintainer.example

# Stage 5B.2: the local stack's JWT signing keys. This file contains
# PRIVATE keys — anything holding it can mint access tokens for that
# stack. `.env.*` does not cover it, so it is named explicitly.
supabase/signing_keys.json
signing_keys.json

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

node_modules/

# Disposable Stage 5A Supabase working directory
.local/supabase-5a/
