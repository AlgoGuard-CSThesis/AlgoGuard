# Jupyter checkpoints
.ipynb_checkpoints/

# Generated research outputs
research/dataset/processed/*
!research/dataset/processed/.gitkeep
research/models/*
!research/models/.gitkeep

# Backup files
*.bak
*.tmp

# Test and lint output
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime artifacts
uploads/*
!uploads/.gitignore
!uploads/.gitkeep
saved_models/*
!saved_models/.gitignore
!saved_models/.gitkeep
reports/*
!reports/.gitignore
!reports/.gitkeep
database/*
!database/.gitignore
!database/.gitkeep

# Packet capture recordings (may contain traffic from your network)
captures/*
!captures/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
ENV/

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.maintainer.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

node_modules/